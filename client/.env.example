# =================================================================
# client/.env.example — Template for client environment variables
# =================================================================
# Copy this file to .env and fill in the correct values.
# The actual .env is in .gitignore and should never be committed.
# =================================================================

# Base URL for REST API calls (uses Vite proxy in development)
VITE_API_URL=/api

# Full URL of the backend (used by Socket.IO client directly)
# Development: http://localhost:5000
# Production:  https://your-app-name.onrender.com
VITE_SERVER_URL=http://localhost:5000
