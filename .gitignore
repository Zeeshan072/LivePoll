# ============================================================
# .gitignore — Files Git should NOT track
# ============================================================

# ── Node.js dependencies ──────────────────────────────────
# These folders are huge and can be re-created by running npm install
node_modules/
client/node_modules/
server/node_modules/

# ── Environment variables ─────────────────────────────────
# .env contains secrets (database passwords, API keys).
# NEVER commit this file. Use .env.example as the safe template.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env
# Keep .env.example files — they are safe placeholders
!.env.example
!server/.env.example
!client/.env.example

# ── Build output ──────────────────────────────────────────
# Generated when you run: npm run build
client/dist/
build/
dist/

# ── Logs ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── OS / Editor junk ─────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
