# ==============================================
# LivePoll Server — Environment Variables
# ==============================================
# Copy this file, rename it to .env, and fill in your values.
# NEVER commit the actual .env file to GitHub.

# Port the server will run on
PORT=5000

# Your MongoDB Atlas connection string
# Get this from: MongoDB Atlas → Your Cluster → Connect → Drivers
# Replace <username>, <password>, and <cluster-url> with your actual values
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/livepoll?retryWrites=true&w=majority

# The URL where your React frontend is running
# In development: http://localhost:5173 (Vite's default port)
# In production: your Netlify URL, e.g. https://livepoll.netlify.app
CLIENT_URL=http://localhost:5173
